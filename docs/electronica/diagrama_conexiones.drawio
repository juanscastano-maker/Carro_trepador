targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c11" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#9E9E9E;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="356" as="sourcePoint"/><mxPoint x="770" y="486" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c12" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#6D4C41;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="513" as="sourcePoint"/><mxPoint x="995" y="880" as="targetPoint"/><Array as="points"><mxPoint x="885" y="513"/><mxPoint x="885" y="860"/><mxPoint x="995" y="860"/></Array></mxGeometry></mxCell><mxCell id="c13" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#6D4C41;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="513" as="sourcePoint"/><mxPoint x="1215" y="880" as="targetPoint"/><Array as="points"><mxPoint x="1322" y="513"/><mxPoint x="1322" y="860"/><mxPoint x="1215" y="860"/></Array></mxGeometry></mxCell><mxCell id="c14" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#8E24AA;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="443" as="sourcePoint"/><mxPoint x="1660" y="943" as="targetPoint"/><Array as="points"><mxPoint x="1105" y="443"/><mxPoint x="1105" y="790"/><mxPoint x="1630" y="790"/><mxPoint x="1630" y="943"/></Array></mxGeometry></mxCell><mxCell id="c15" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#EF6C00;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="443" as="sourcePoint"/><mxPoint x="1370" y="943" as="targetPoint"/><Array as="points"><mxPoint x="1345" y="443"/><mxPoint x="1345" y="943"/></Array></mxGeometry></mxCell><mxCell id="c16" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#EF6C00;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="1013" as="sourcePoint"/><mxPoint x="1345" y="943" as="targetPoint"/><Array as="points"><mxPoint x="1100" y="1013"/><mxPoint x="1100" y="1070"/><mxPoint x="1345" y="1070"/></Array></mxGeometry></mxCell><mxCell id="c17" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#F9A825;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1013" as="sourcePoint"/><mxPoint x="1370" y="1013" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c18" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1860" y="1013" as="sourcePoint"/><mxPoint x="1950" y="1013" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="t1" value="Carro Trepador — Alimentación" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#263238;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="t2" value="Rojo: batería 4S (15-17.4 V) · Negro: GND común · Morado: 5 V del BEC delantero (motores) · Naranja: 5 V del BEC trasero (lógica) · Amarillo: 3.3 V · Café: fases de los BLDC · Verde: salidas a los N20 · Gris punteado: cables finos de medición" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#37474F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2100" height="24" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;Reglas de la alimentación&lt;/b&gt;&lt;br&gt;1. Cada BEC alimenta solo su parte: BEC delantero (morado) → DRV8833 y 4 N20; BEC trasero (naranja) → ESP32 y 2 GY-521. El INA226 sale del 3V3 de la ESP32.&lt;br&gt;2. NUNCA unir los dos cables rojos de BEC entre sí.&lt;br&gt;3. Los BEC son lineales: lo que sobra de la batería se vuelve calor (unos 5 W con la ESP32, más con los motores). Tocar los ESC tras 5 min de uso: si queman, cambiar a bucks.&lt;br&gt;4. Con el USB conectado a la ESP32, desconectar el rojo del BEC trasero (nunca dos fuentes de 5 V a la vez). El GND se deja conectado.&lt;br&gt;5. XT30 = interruptor general: conectar y desconectar de un solo movimiento; la chispa al conectar es normal. Aguanta unos 15 A continuos: con succión alta sostenida, usar XT60." style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#263238;align=left;fillColor=#FFFDE7;strokeColor=#F9A825;rounded=1;arcSize=3;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1360" y="290" width="800" height="290" as="geometry"/></mxCell><mxCell id="t4" value="Quitar el shunt R100 del módulo. Los bornes Vin+/Vin− del módulo son los mismos IN+/IN−." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#37474F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="630" width="230" height="60" as="geometry"/></mxCell><mxCell id="t5" value="GY-521 con 5 V: tienen regulador propio y sus señales quedan en 3.3 V. INA226 siempre con 3.3 V: no tiene regulador y sus pull-ups pondrían 5 V en la ESP32." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#37474F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="780" height="50" as="geometry"/></mxCell><mxCell id="t6" value="DRV8833 con el puente J1 cerrado: EEP queda unido a VCC (5 V) y el chip siempre activo. No conectar EEP a la ESP32. Capacitor de 100 µF entre VCC y GND y de 100 nF en cada motor." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#37474F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="780" height="50" as="geometry"/></mxCell><mxCell id="t7" value="Todas las tierras unidas (GND común). Cargar la batería a 4.20 V por celda mientras se prueba. Nunca unir los dos rojos de BEC." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#C62828;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="2100" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="senales" name="2. Señales"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b3" value="ESP32-S3 (Freenove WROOM CAM)&lt;br&gt;N16R8" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="330" height="830" as="geometry"/></mxCell><mxCell id="b21" value="GY-521 (MPU6050)&lt;br&gt;módulo delantero · 0x68" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="130" y="120" width="250" height="300" as="geometry"/></mxCell><mxCell id="b29" value="GY-521 (MPU6050)&lt;br&gt;módulo trasero · 0x69" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="130" y="440" width="250" height="300" as="geometry"/></mxCell><mxCell id="b37" value="INA226 (módulo) · 0x40" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="130" y="760" width="250" height="240" as="geometry"/></mxCell><mxCell id="b54" value="DRV8833 (módulo)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="250" height="350" as="geometry"/></mxCell><mxCell id="b73" value="N20 medio izq." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;fon