<mxfile host="drawio"><diagram id="alimentacion" name="1. Alimentación"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bat" value="Batería LiPo HV 4S&lt;br&gt;1100 mAh (XT30)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="190" height="170" as="geometry"/></mxCell><mxCell id="xt30" value="XT30 (interruptor)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="150" height="70" as="geometry"/></mxCell><mxCell id="fus" value="Fusible 40 A" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="130" height="70" as="geometry"/></mxCell><mxCell id="shunt" value="Shunt 1 mΩ (≥2 W)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="160" height="70" as="geometry"/></mxCell><mxCell id="ina_mod" value="INA226 (módulo)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="180" height="160" as="geometry"/></mxCell><mxCell id="esc_d" value="ESC Skywalker V2 30A&lt;br&gt;delantero" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="900" y="290" width="190" height="290" as="geometry"/></mxCell><mxCell id="esc_t" value="ESC Skywalker V2 30A&lt;br&gt;trasero" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="1120" y="290" width="190" height="290" as="geometry"/></mxCell><mxCell id="bldc_d" value="BLDC XING2 1404&lt;br&gt;4600KV delantero" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="880" width="190" height="70" as="geometry"/></mxCell><mxCell id="bldc_t" value="BLDC XING2 1404&lt;br&gt;4600KV trasero" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1120" y="880" width="190" height="70" as="geometry"/></mxCell><mxCell id="gy" value="2 × GY-521" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="965" width="190" height="75" as="geometry"/></mxCell><mxCell id="ina" value="INA226" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1120" y="965" width="190" height="75" as="geometry"/></mxCell><mxCell id="esp" value="ESP32-S3 (Freenove)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="890" width="220" height="150" as="geometry"/></mxCell><mxCell id="drv" value="DRV8833 (módulo)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1650" y="890" width="220" height="150" as="geometry"/></mxCell><mxCell id="n20" value="4 × N20 (a 5 V)&lt;br&gt;(2 por lado, en paralelo)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1950" y="972" width="210" height="80" as="geometry"/></mxCell><mxCell id="bat_p" value="+ (rojo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="140" height="26" as="geometry"/></mxCell><mxCell id="bat_n" value="− (negro)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="90" y="380" width="140" height="26" as="geometry"/></mxCell><mxCell id="xt_e" value="entrada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="290" y="330" width="75" height="26" as="geometry"/></mxCell><mxCell id="xt_s" value="salida" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="365" y="330" width="75" height="26" as="geometry"/></mxCell><mxCell id="fus_e" value="entrada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="65" height="26" as="geometry"/></mxCell><mxCell id="fus_s" value="salida" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="545" y="330" width="65" height="26" as="geometry"/></mxCell><mxCell id="sh_b" value="lado batería" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="650" y="330" width="80" height="26" as="geometry"/></mxCell><mxCell id="sh_c" value="lado carga" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="730" y="330" width="80" height="26" as="geometry"/></mxCell><mxCell id="ina_p" value="IN+" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="652" y="486" width="76" height="26" as="geometry"/></mxCell><mxCell id="ina_n" value="IN−" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="732" y="486" width="76" height="26" as="geometry"/></mxCell><mxCell id="ina_vbs" value="VBS → IN−" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="652" y="522" width="156" height="26" as="geometry"/></mxCell><mxCell id="ina_vcc" value="VCC ← 3V3 (ESP32)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="652" y="558" width="156" height="26" as="geometry"/></mxCell><mxCell id="ed_bp" value="B+" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="910" y="290" width="170" height="26" as="geometry"/></mxCell><mxCell id="ed_sen" value="Señal (blanco) → GPIO 41" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="910" y="370" width="170" height="26" as="geometry"/></mxCell><mxCell id="ed_gnd" value="Negro fino → GND ESP32" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="910" y="400" width="170" height="26" as="geometry"/></mxCell><mxCell id="ed_bec" value="BEC 5 V (rojo) → DRV8833" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="910" y="430" width="170" height="26" as="geometry"/></mxCell><mxCell id="ed_ama" value="Amarillo: aislar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#78909C;fontSize=13;spacing=2;fontColor=#9E9E9E;dashed=1;" vertex="1" parent="1"><mxGeometry x="910" y="460" width="170" height="26" as="geometry"/></mxCell><mxCell id="ed_fas" value="3 fases" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="910" y="500" width="170" height="26" as="geometry"/></mxCell><mxCell id="ed_bn" value="B−" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="910" y="554" width="170" height="26" as="geometry"/></mxCell><mxCell id="et_bp" value="B+" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1130" y="290" width="170" height="26" as="geometry"/></mxCell><mxCell id="et_sen" value="Señal (blanco) → GPIO 42" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1130" y="370" width="170" height="26" as="geometry"/></mxCell><mxCell id="et_gnd" value="Negro fino → GND ESP32" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1130" y="400" width="170" height="26" as="geometry"/></mxCell><mxCell id="et_bec" value="BEC 5 V (rojo) → ESP32" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1130" y="430" width="170" height="26" as="geometry"/></mxCell><mxCell id="et_ama" value="Amarillo: aislar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#78909C;fontSize=13;spacing=2;fontColor=#9E9E9E;dashed=1;" vertex="1" parent="1"><mxGeometry x="1130" y="460" width="170" height="26" as="geometry"/></mxCell><mxCell id="et_fas" value="3 fases" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1130" y="500" width="170" height="26" as="geometry"/></mxCell><mxCell id="et_bn" value="B−" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1130" y="554" width="170" height="26" as="geometry"/></mxCell><mxCell id="gy_vcc" value="VCC (5 V)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="910" y="1000" width="170" height="26" as="geometry"/></mxCell><mxCell id="ina_vcc2" value="VCC (3.3 V)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1130" y="1000" width="170" height="26" as="geometry"/></mxCell><mxCell id="esp_5v" value="5V (también a GY-521)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1370" y="930" width="200" height="26" as="geometry"/></mxCell><mxCell id="esp_gnd" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1370" y="965" width="200" height="26" as="geometry"/></mxCell><mxCell id="esp_3v3" value="3V3 (salida)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1370" y="1000" width="200" height="26" as="geometry"/></mxCell><mxCell id="drv_vcc" value="VCC ← 5 V (BEC delantero)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex=