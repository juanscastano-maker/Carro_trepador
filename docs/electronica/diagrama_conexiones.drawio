rent="1"><mxGeometry x="1300" y="880" width="150" height="26" as="geometry"/></mxCell><mxCell id="p103" value="Rojo fino (BEC) → ESP32 5V" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#78909C;fontSize=13;spacing=2;" vertex="1" parent="1"><mxGeometry x="1300" y="920" width="210" height="26" as="geometry"/></mxCell><mxCell id="p104" value="Amarillo: aislar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#78909C;fontSize=13;spacing=2;fontColor=#9E9E9E;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300" y="960" width="210" height="26" as="geometry"/></mxCell><mxCell id="t1" value="Carro Trepador — Señales (Freenove ESP32-S3 WROOM CAM N16R8)" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#263238;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="t2" value="Azul: SDA · Turquesa: SCL · Violeta: INT · Magenta: ALERTA compartida · Verde: PWM del DRV8833 y salidas a los motores · Naranja: señal de los ESC. Fondo rojo: alimentación; gris: GND; punteado: no se conecta." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#37474F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1950" height="24" as="geometry"/></mxCell><mxCell id="t20" value="No usar: GPIO 4-13 y 15-18 (cámara), 35-37 (PSRAM), 43-44 (CH340), 0, 45 y 46 (arranque). 19-20 (USB OTG) de reserva. No insertar microSD (usa 38-40). Programar por el USB-C del CH340." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#B71C1C;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="770" width="160" height="170" as="geometry"/></mxCell><mxCell id="t43" value="IN+, IN−, VBS: página de alimentación" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#37474F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="138" y="972" width="240" height="20" as="geometry"/></mxCell><mxCell id="t53" value="I2C a 100 kHz. Cable a la IMU delantera: trenzado con GND y flexible en la articulación." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#37474F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1030" width="520" height="40" as="geometry"/></mxCell><mxCell id="t72" value="ULT: medir su voltaje antes de conectarlo; si pasa de 3.6 V, usar divisor 10 kΩ / 20 kΩ." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#B71C1C;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="480" width="330" height="40" as="geometry"/></mxCell><mxCell id="t93" value="Lado izquierdo en OUT1/OUT2 y derecho en OUT3/OUT4, dos motores en paralelo por lado. Si un lado gira al revés, invertir sus cables (o usar el comando 'inv' de la prueba)." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#37474F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1760" y="560" width="290" height="80" as="geometry"/></mxCell><mxCell id="c44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#1565C0;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p25" target="p6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="293.0"/><mxPoint x="470" y="333.0"/></Array></mxGeometry></mxCell><mxCell id="c45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#00838F;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p24" target="p7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="259.0"/><mxPoint x="500" y="373.0"/></Array></mxGeometry></mxCell><mxCell id="c46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#1565C0;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" p